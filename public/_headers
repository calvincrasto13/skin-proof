# Cloudflare Pages response headers.
#
# Cross-origin isolation (COOP + COEP) lets ONNX Runtime's WASM fallback use threads
# (SharedArrayBuffer). Everything cross-origin the app loads is fetched in CORS mode:
# the depth model from Hugging Face, ONNX Runtime from jsDelivr, fonts from Google.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite's hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
